# Telegram
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=123456789
TELEGRAM_CHAT_IDS=123456789,-1001234567890
TELEGRAM_HEALTH_CHAT_IDS=123456789
TELEGRAM_TIMEOUT_MS=20000
TELEGRAM_RETRIES=3

# BNB Smart Chain mainnet RPCs. The bot tries them in order.
# Public RPCs can rate-limit eth_getLogs; for production use a paid/dedicated endpoint.
TATUM_API_KEY=
BSC_RPC_URLS=https://bsc.rpc.blxrbdn.com,https://bsc-mainnet.gateway.tatum.io
BSC_WS_URLS=wss://bsc-rpc.publicnode.com,wss://bsc.drpc.org
USE_WEBSOCKET=true
LOG_WEBSOCKET_DECODED_SUMMARY=true
WEBSOCKET_DECODED_SUMMARY_INTERVAL_MS=30000
TELEGRAM_HEALTH_UPDATE_ENABLED=true
TELEGRAM_HEALTH_UPDATE_INTERVAL_MS=3600000
RPC_TIMEOUT_MS=20000
RPC_MIN_DELAY_MS=400

# BSC USDT uses 18 decimals.
TOKEN_SYMBOL=USDT
TOKEN_DECIMALS=18
MIN_ALERT_AMOUNT=1

# Optional indexed fallback. BscScan keys are separate from Etherscan V2 keys.
BSCSCAN_API_KEY=
ETHERSCAN_API_KEY=

# Wallets to watch. Format: Label=address,Label=address
WATCHED_WALLETS=Valdora Zignaly= , Nawa Zignaly=

# Start from the latest confirmed BSC block whenever the bot boots.
START_FROM_LATEST_ON_BOOT=true

# Polling settings
POLL_INTERVAL_MS=10000
CONFIRMATIONS=1
MAX_BLOCK_RANGE=5
MAX_BACKLOG_BLOCKS=25
STATE_FILE=/app/data/state.json

# Alerts
ALERT_INCOMING=true
ALERT_OUTGOING=true
ALERT_ON_STARTUP=true
SEND_TEST_ALERTS_ON_STARTUP=false
LOG_SCAN_PROGRESS=true

# Sends Telegram messages for actual historical USDT transfers found on-chain at startup.
SEND_RECENT_REAL_ALERTS_ON_STARTUP=true
RECENT_REAL_ALERT_LOOKBACK_BLOCKS=500
RECENT_REAL_ALERT_BLOCK_RANGE=10
RECENT_REAL_ALERT_MAX_PER_WALLET=3
ALERT_WHEN_NO_RECENT_REAL_TRANSFERS=true

# Optional one-off verification mode. If VERIFY_BLOCK is set, the bot scans only that block and exits.
VERIFY_BLOCK=
VERIFY_TO_BLOCK=
TELEGRAM_COMMANDS_ENABLED=true
TELEGRAM_COMMAND_POLL_INTERVAL_MS=5000
